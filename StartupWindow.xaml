<Window x:Class="SecureOverlay.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom" Width="880" Height="610" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0C1018">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172336" Offset="0"/>
            <GradientStop Color="#0C1018" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageGlow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Margin="28" CornerRadius="22" Background="#CC101726" BorderBrush="#334A6484" BorderThickness="1.5">
                <Grid Margin="34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Phantom" Foreground="White" FontSize="34" FontWeight="Bold"/>
                        <TextBlock Text="Desktop Access Gate" Foreground="#98B8D8" FontSize="15" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,24,0,0" CornerRadius="18" Background="#AA111A2A" Padding="24">
                        <StackPanel>
                            <TextBlock x:Name="StateTitleText" Text="Welcome To Phantom" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="StateMessageText" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="15" LineHeight="23" Foreground="#D3E5F5"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="18" Background="#88101927" Padding="24" Margin="0,0,18,0" MinHeight="250">
                            <StackPanel>
                                <TextBlock x:Name="LeftPanelTitleText" Text="Login Methods" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LeftPanelMessageText" Text="Choose a sign-in method. Login stays in-app. Registration opens on the hosted website." TextWrapping="Wrap" Foreground="#9AB6D3" FontSize="13" Margin="0,10,0,18"/>

                                <Border x:Name="ChoicePanel" Background="#44273B53" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                    <TextBlock Text="Select Login or Magic Link to continue. The credentials form appears on the next step so the first screen stays uncluttered on smaller displays." TextWrapping="Wrap" Foreground="#D9E8F4" FontSize="12" LineHeight="18"/>
                                </Border>

                                <StackPanel x:Name="CredentialsPanel" Visibility="Collapsed">
                                    <Border Background="#3E24425E" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Default Stub User" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Email: local-user@phantom.app" Foreground="#D3E5F5" FontSize="12" Margin="0,8,0,0"/>
                                            <TextBlock Text="Password: phantom123" Foreground="#D3E5F5" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Email" Foreground="#9AB6D3" FontSize="12"/>
                                    <TextBox x:Name="EmailTextBox" Margin="0,8,0,14" MinHeight="42" Padding="12,9" FontSize="14" Background="#E8F0F8" BorderThickness="0"/>

                                    <TextBlock x:Name="PasswordLabel" Text="Password" Foreground="#9AB6D3" FontSize="12"/>
                                    <PasswordBox x:Name="PasswordTextBox" Margin="0,8,0,10" MinHeight="42" Padding="12,9" FontSize="14" Background="#E8F0F8" BorderThickness="0"/>
                                </StackPanel>

                                <TextBlock x:Name="InlineStatusText" Foreground="#FFCC7A" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="18" Background="#5516283D" Padding="24" MinHeight="250">
                            <StackPanel>
                                <TextBlock Text="Launch Rules" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Registration happens on the website. Login stays in-app. MainWindow stays blocked until startup checks pass." TextWrapping="Wrap" Foreground="#D3E5F5" FontSize="13" Margin="0,10,0,18"/>

                                <Border Background="#6620354D" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <TextBlock Text="Current implementation status: local stub mode. Use this gate to exercise the production startup flow without backend dependencies." TextWrapping="Wrap" Foreground="#D9E8F4" FontSize="12" LineHeight="18"/>
                                </Border>

                                <TextBlock x:Name="SafeModeText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFD89A" FontSize="12" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,24,0,0" ItemHeight="46" ItemWidth="140">
                        <Button x:Name="LoginButton" Content="Login" Width="140" Background="#1976D2" Style="{StaticResource ActionButtonStyle}" Click="LoginButton_Click"/>
                        <Button x:Name="MagicLinkButton" Content="Magic Link" Width="140" Background="#2A4E77" Style="{StaticResource ActionButtonStyle}" Click="MagicLinkButton_Click"/>
                        <Button x:Name="RegisterButton" Content="Register On Website" Width="190" Background="#264653" Style="{StaticResource ActionButtonStyle}" Click="RegisterButton_Click"/>
                        <Button x:Name="BackButton" Content="Back" Width="120" Background="#455A64" Style="{StaticResource ActionButtonStyle}" Click="BackButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="SignOutButton" Content="Sign Out" Width="120" Background="#8C3A3A" Style="{StaticResource ActionButtonStyle}" Click="SignOutButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="RetryButton" Content="Retry" Width="120" Background="#5E6472" Style="{StaticResource ActionButtonStyle}" Click="RetryButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="ContinueButton" Content="Open App" Width="140" Background="#2A9D8F" Style="{StaticResource ActionButtonStyle}" Click="ContinueButton_Click" Visibility="Collapsed"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
