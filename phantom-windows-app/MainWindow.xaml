<Window x:Class="SecureOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom" Height="500" Width="900" MinHeight="100" MinWidth="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Left="100" Top="100"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Cursor="Arrow"
        ForceCursor="True">
    
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="3" BlurRadius="10" Opacity="1" Color="Black"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hidden WebView2 Container (for voice recognition) -->
        <Grid x:Name="WebView2Container" 
              Visibility="Collapsed" 
              Width="1" 
              Height="1"/>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CHAT PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ChatPageContainer" Visibility="Visible">
            <!-- Outer Shadow -->
            <Border x:Name="OuterShadowBorder" Background="Transparent" CornerRadius="14" Margin="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="35" Opacity="0.9" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Main Background -->
            <Border x:Name="WindowChromeBorder" Background="#96000000" CornerRadius="12" Margin="0"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                    BorderBrush="Transparent" BorderThickness="0"/>

            <!-- Content -->
            <Grid x:Name="MainContentGrid" Margin="18,14,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title bar -->
                    <RowDefinition x:Name="ChatSectionRow" Height="*"/>     <!-- Chat section -->
                </Grid.RowDefinitions>


                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- TITLE BAR (Grid.Row="0") - ENHANCED WITH INTERACTIVE DROPDOWNS -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Margin="-4,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="24" Margin="0,0,6,0"/>
                        <TextBlock Text="Phantom" FontSize="18" FontWeight="Bold"
                                Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"
                                Effect="{StaticResource Shadow}"/>
                        
                        <!-- API Key Indicator -->
                        <Border x:Name="APIKeyIndicator" Background="#5000FF00" CornerRadius="4" 
                                Padding="6,4" Margin="5,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="APIKeyText" Text="Key #1" FontSize="10" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="CreditIndicatorBorder" Background="#506A4C1F" CornerRadius="4" Padding="8,4" Margin="5,0,0,0">
                            <TextBlock x:Name="CreditIndicatorText" Text="Credits: --" FontSize="11"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="SessionTimerBorder" Background="#503A245D" CornerRadius="4" Padding="8,4" Margin="5,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SessionTimerText" Text="Session 00:00:00" FontSize="11"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="TokenCounterBorder" Background="#5000AAFF" CornerRadius="4" Padding="8,4" Margin="10,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TokenCounterText" Text="0k/8k" FontSize="11" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border Background="#30404A58" CornerRadius="6" Padding="10,6" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Opacity" FontSize="11" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Effect="{StaticResource Shadow}"/>
                                <Slider x:Name="HeaderOpacitySlider"
                                        Width="110"
                                        Minimum="0.30"
                                        Maximum="1.20"
                                        Value="0.92"
                                        ValueChanged="HeaderOpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CollapsedHeaderMicButton" Content="🎤" Width="40" Height="32" Click="VoiceButton_Click"
                            Background="#5000AA00" BorderBrush="#9000AA00" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource ButtonStyle}"/>

                        <Button x:Name="ChatCollapseButton" Content="▴" Width="40" Height="32" Click="ChatCollapseButton_Click"
                            Background="#50505050" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>

                        <!-- AUTO-RESTART BUTTON -->
                        <Button Content="🔄" Width="40" Height="32" Click="RestartButton_Click"
                            Background="#50FF6B00" BorderBrush="#90FF6B00" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>

                        <!-- NEW TOPIC BUTTON -->
                        <Button Content="📝" Width="40" Height="32" Click="NewTopicButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <!-- CLEAR CHAT BUTTON -->
                        <Button Content="🔃" Width="40" Height="32" Click="ClearChatButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="⚙️" Width="40" Height="32" Click="SettingsButton_Click"
                            Background="#5000AAFF" BorderBrush="#9000AAFF" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="–" Width="40" Height="32" Click="MinimizeButton_Click"
                            Background="#55FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="✕" Width="40" Height="32" Click="CloseButton_Click"
                            Background="#55FF4444" BorderBrush="#90FF4444" BorderThickness="1.5"
                            Foreground="White" FontSize="16" FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                    </StackPanel>
                </Grid>

                
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- STATUS BANNERS (Grid.Row="1") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="ChatSectionContainer" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border x:Name="LaunchRestrictionBanner"
                            Background="#50FFB000" CornerRadius="6"
                            Padding="10" Margin="0,0,0,10"
                            Visibility="Collapsed"
                            BorderBrush="#90FFB000" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="LaunchRestrictionTitle"
                                           Text="Restricted Session"
                                           FontSize="13" FontWeight="Bold" Foreground="White"
                                           Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="LaunchRestrictionDetails"
                                           Text="Interview actions are currently blocked."
                                           TextWrapping="Wrap"
                                           FontSize="10" Foreground="#FFF0D0"
                                           Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DebugModeWarning"
                            Background="#50FF0000" CornerRadius="6"
                            Padding="10" Margin="0,0,0,10"
                            Visibility="Collapsed"
                            BorderBrush="#90FF0000" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="DebugModeText"
                                           Text="DEBUG MODE: Simulating API Errors"
                                           FontSize="13" FontWeight="Bold" Foreground="White"
                                           Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="DebugModeDetails"
                                           Text="Mode: None | Requests: 0"
                                           FontSize="10" Foreground="#FFCCCC"
                                           Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- CHAT DISPLAY (Grid.Row="1") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Background="#40000000" BorderBrush="#70FFFFFF" 
                        BorderThickness="1.5" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                        MouseDown="ChatArea_MouseDown"
                        Cursor="Arrow"
                        ForceCursor="True">
                    <FlowDocumentScrollViewer x:Name="ChatScrollViewer" 
                                            VerticalScrollBarVisibility="Auto"
                                            IsToolBarVisible="False"
                                            Background="Transparent"
                                            Foreground="White"
                                            SelectionBrush="#8000AAFF"
                                            Cursor="Arrow"
                                            ForceCursor="True">
                        <FlowDocument x:Name="ChatDocument" 
                                    FontFamily="Segoe UI"
                                    FontSize="14"
                                    Foreground="White"
                                    PagePadding="0"
                                    Background="Transparent">
                            <!-- Content will be added dynamically -->
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- INPUT AREA (Grid.Row="2") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- Input box -->
                        <ColumnDefinition Width="Auto"/>   <!-- Screenshot button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Provider button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Model button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Voice button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Send button -->
                    </Grid.ColumnDefinitions>

                    <!-- Input Text Box -->
                    <Border Grid.Column="0" Background="#40000000" BorderBrush="#70FFFFFF" 
                            BorderThickness="1.5" CornerRadius="8" Padding="12,8"
                            MouseDown="InputBorder_MouseDown"
                            x:Name="InputBorder"
                            Cursor="Arrow"
                            ForceCursor="True">
                        <TextBox x:Name="InputTextBox" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="White" 
                                FontSize="14" 
                                CaretBrush="White"
                                VerticalAlignment="Stretch"
                                Effect="{StaticResource Shadow}"
                                PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                PreviewMouseDown="InputTextBox_PreviewMouseDown"
                                Text="Ask me anything..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="150"
                                Cursor="Arrow"
                                ForceCursor="True">
                            <TextBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste"/>
                            </TextBox.CommandBindings>
                        </TextBox>
                    </Border>

                    <!-- Screenshot Button (Grid.Column="1") -->
                    <Button Grid.Column="1" x:Name="ScreenshotButton"
                            Width="50" Height="40"
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="18"
                            Style="{StaticResource ButtonStyle}"
                            Click="ScreenshotButton_Click"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ScreenshotButtonText" Text="📸" FontSize="18"/>
                    </Button>

                    <Border Grid.Column="2" Background="#50FFD700" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="ProviderSelector_Click"
                            x:Name="ProviderSelectorBorder" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AIProviderText" Text="ChatGPT" FontSize="11" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                            <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#5000AAFF" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                            Cursor="Hand" MouseLeftButtonDown="ModelSelector_Click"
                            x:Name="ModelSelectorBorder" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModelText" Text="" FontSize="11" MaxWidth="92" TextTrimming="CharacterEllipsis"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                            <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Voice Button (Grid.Column="4") -->
                    <Button Grid.Column="4" x:Name="VoiceButton" 
                            Content="🎤" 
                            Width="50" Height="40"
                            Click="VoiceButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AA00" 
                            BorderBrush="#9000AA00" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="20" 
                            Style="{StaticResource ButtonStyle}"/>

                    <!-- Send Button (Grid.Column="5") -->
                    <Button Grid.Column="5" x:Name="SendButton"
                            Content="➜" 
                            Width="42" Height="40"
                            Click="SendButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- STATUS BAR (Grid.Row="3") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="3" Background="#40000000" CornerRadius="6" 
                       Padding="12,8" BorderBrush="#60FFFFFF" BorderThickness="1"
                       MouseDown="StatusBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator" Width="10" Height="10" 
                                    Fill="#00FF00" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="1.0" Color="#00FF00"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="✓ Protected | Two-cursor system active" 
                                      FontSize="12" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SessionStatusText" Text="" 
                                      FontSize="12" Foreground="#71D9D7" Margin="0,0,12,0"
                                      Effect="{StaticResource Shadow}"/>
                            <TextBlock x:Name="VoiceStatusText" Text="" 
                                      FontSize="12" Foreground="#FFD700" 
                                      Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- DEBUG PANEL (Grid.Row="4") - COLLAPSIBLE -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" x:Name="DebugPanel" 
                        Background="#50000000" BorderBrush="#70FF00FF" BorderThickness="2"
                        CornerRadius="8" Padding="10" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Debug Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🐛" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Debug Logs (Also Invisible!)" FontSize="14" FontWeight="Bold"
                                        Foreground="#FF00FF" Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔍 View Context" Width="100" Height="25" Click="ViewContextButton_Click"
                                    Background="#5000FFFF" BorderBrush="#9000FFFF" BorderThickness="1"
                                    Foreground="White" FontSize="11" Margin="0,0,5,0"
                                    Style="{StaticResource ButtonStyle}"/>
                                
                                <Button Content="📋 Copy" Width="70" Height="25" Click="CopyLogsButton_Click"
                                    Background="#50FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1"
                                    Foreground="White" FontSize="11" Margin="0,0,5,0"
                                    Style="{StaticResource ButtonStyle}"/>
                                <Button Content="🗑️ Clear" Width="70" Height="25" Click="ClearLogsButton_Click"
                                    Background="#50FF0000" BorderBrush="#90FF0000" BorderThickness="1"
                                    Foreground="White" FontSize="11"
                                    Style="{StaticResource ButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Debug Log Viewer -->
                        <Border Grid.Row="1" Background="#30000000" BorderBrush="#50FFFFFF" 
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ScrollViewer x:Name="DebugScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DebugLogsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" 
                                                      Foreground="#00FF00" FontFamily="Consolas" 
                                                      FontSize="11" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Auto-scroll toggle -->
                        <CheckBox Grid.Row="2" x:Name="AutoScrollCheckBox" 
                                 Content="Auto-scroll to latest" 
                                 Foreground="White" FontSize="11" Margin="0,8,0,0"
                                 IsChecked="True"/>
                    </Grid>
                </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SETTINGS PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="SettingsPageContainer" Visibility="Collapsed">
            <ContentControl x:Name="SettingsPageHost"/>
        </Grid>

        <Thumb Width="8" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Left"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="8" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Right"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Height="8" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Top"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Height="8" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Bottom"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="TopLeft"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="TopRight"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="BottomLeft"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="BottomRight"
               DragDelta="ResizeThumb_DragDelta"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM CURSOR CANVAS - TOP LAYER (Invisible to screen share!) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Canvas x:Name="CustomCursorCanvas" 
                IsHitTestVisible="False" 
                Background="Transparent"/>
    </Grid>
</Window>
