<Window x:Class="SecureOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant" Height="500" Width="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Left="100" Top="100"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Cursor="Arrow"
        ForceCursor="True">
    
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="3" BlurRadius="10" Opacity="1" Color="Black"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hidden WebView2 Container (for voice recognition) -->
        <Grid x:Name="WebView2Container" 
              Visibility="Collapsed" 
              Width="1" 
              Height="1"/>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CHAT PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ChatPageContainer" Visibility="Visible">
            <!-- Outer Shadow -->
            <Border Background="#60000000" CornerRadius="15" Margin="8">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="35" Opacity="0.9" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Main Background -->
            <Border Background="#70000000" CornerRadius="12" Margin="10" 
                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                    BorderBrush="#90FFFFFF" BorderThickness="2"/>

            <!-- Content -->
            <Grid Margin="30,25,30,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title bar -->
                    <RowDefinition Height="Auto"/>  <!-- Debug warning banner -->
                    <RowDefinition Height="*"/>     <!-- Chat display -->
                    <RowDefinition Height="Auto"/>  <!-- Input area -->
                    <RowDefinition Height="Auto"/>  <!-- Status bar -->
                    <RowDefinition Height="Auto"/>  <!-- Debug panel -->
                </Grid.RowDefinitions>


                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- TITLE BAR (Grid.Row="0") - ENHANCED WITH INTERACTIVE DROPDOWNS -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="AI Assistant" FontSize="18" FontWeight="Bold"
                                Foreground="White" VerticalAlignment="Center" Effect="{StaticResource Shadow}"/>
                        
                        <!-- Provider Selector -->
                        <Border Background="#50FFD700" CornerRadius="4" Padding="8,4" Margin="15,0,0,0"
                                Cursor="Hand" MouseLeftButtonDown="ProviderSelector_Click"
                                x:Name="ProviderSelectorBorder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AIProviderText" Text="ChatGPT" FontSize="11" 
                                        FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                                <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Model Selector -->
                        <Border Background="#5000AAFF" CornerRadius="4" Padding="8,4" Margin="5,0,0,0"
                                Cursor="Hand" MouseLeftButtonDown="ModelSelector_Click"
                                x:Name="ModelSelectorBorder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModelText" Text="" FontSize="11" 
                                        FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                                <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- API Key Indicator -->
                        <Border x:Name="APIKeyIndicator" Background="#5000FF00" CornerRadius="4" 
                                Padding="6,4" Margin="5,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="APIKeyText" Text="Key #1" FontSize="10" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <!-- Token Counter -->
                        <Border Background="#5000AAFF" CornerRadius="4" Padding="8,4" Margin="10,0,0,0">
                            <TextBlock x:Name="TokenCounterText" Text="0k/8k" FontSize="11" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- AUTO-RESTART BUTTON -->
                        <Button Content="🔄" Width="40" Height="32" Click="RestartButton_Click"
                            Background="#50FF6B00" BorderBrush="#90FF6B00" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>

                        <!-- NEW TOPIC BUTTON -->
                        <Button Content="📝" Width="40" Height="32" Click="NewTopicButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <!-- CLEAR CHAT BUTTON -->
                        <Button Content="🔃" Width="40" Height="32" Click="ClearChatButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <!-- DEBUG BUTTON -->
                        <Button Content="🐛" Width="40" Height="32" Click="DebugButton_Click"
                            Background="#50AA00AA" BorderBrush="#90AA00AA" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="⚙️" Width="40" Height="32" Click="SettingsButton_Click"
                            Background="#5000AAFF" BorderBrush="#9000AAFF" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="–" Width="40" Height="32" Click="MinimizeButton_Click"
                            Background="#55FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="✕" Width="40" Height="32" Click="CloseButton_Click"
                            Background="#55FF4444" BorderBrush="#90FF4444" BorderThickness="1.5"
                            Foreground="White" FontSize="16" FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                    </StackPanel>
                </Grid>

                
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- DEBUG MODE WARNING BANNER (Grid.Row="1") ← FIXED! -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border x:Name="DebugModeWarning" Grid.Row="1" 
                        Background="#50FF0000" CornerRadius="6" 
                        Padding="10" Margin="0,0,0,10" 
                        Visibility="Collapsed"
                        BorderBrush="#90FF0000" BorderThickness="2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧪" FontSize="20" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock x:Name="DebugModeText" 
                                    Text="DEBUG MODE: Simulating API Errors" 
                                    FontSize="13" FontWeight="Bold" Foreground="White"
                                    Effect="{StaticResource Shadow}"/>
                            <TextBlock x:Name="DebugModeDetails" 
                                    Text="Mode: None | Requests: 0" 
                                    FontSize="10" Foreground="#FFCCCC"
                                    Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- CHAT DISPLAY (Grid.Row="2") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" Background="#40000000" BorderBrush="#70FFFFFF" 
                        BorderThickness="1.5" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                        MouseDown="ChatArea_MouseDown"
                        Cursor="Arrow"
                        ForceCursor="True">
                    <FlowDocumentScrollViewer x:Name="ChatScrollViewer" 
                                            VerticalScrollBarVisibility="Auto"
                                            IsToolBarVisible="False"
                                            Background="Transparent"
                                            Foreground="White"
                                            SelectionBrush="#8000AAFF"
                                            Cursor="Arrow"
                                            ForceCursor="True">
                        <FlowDocument x:Name="ChatDocument" 
                                    FontFamily="Segoe UI"
                                    FontSize="14"
                                    Foreground="White"
                                    PagePadding="0"
                                    Background="Transparent">
                            <!-- Content will be added dynamically -->
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- INPUT AREA (Grid.Row="3") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- Input box -->
                        <ColumnDefinition Width="Auto"/>   <!-- Screenshot button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Voice button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Send button -->
                    </Grid.ColumnDefinitions>

                    <!-- Input Text Box -->
                    <Border Grid.Column="0" Background="#40000000" BorderBrush="#70FFFFFF" 
                            BorderThickness="1.5" CornerRadius="8" Padding="12,8"
                            MouseDown="InputBorder_MouseDown"
                            x:Name="InputBorder"
                            Cursor="Arrow"
                            ForceCursor="True">
                        <TextBox x:Name="InputTextBox" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="White" 
                                FontSize="14" 
                                CaretBrush="White"
                                VerticalAlignment="Stretch"
                                Effect="{StaticResource Shadow}"
                                PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                PreviewMouseDown="InputTextBox_PreviewMouseDown"
                                Text="Ask me anything..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="150"
                                Cursor="Arrow"
                                ForceCursor="True">
                            <TextBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste"/>
                            </TextBox.CommandBindings>
                        </TextBox>
                    </Border>

                    <!-- Screenshot Button (Grid.Column="1") -->
                    <Button Grid.Column="1" x:Name="ScreenshotButton"
                            Width="50" Height="40"
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="18"
                            Style="{StaticResource ButtonStyle}"
                            Click="ScreenshotButton_Click"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ScreenshotButtonText" Text="📸" FontSize="18"/>
                    </Button>

                    <!-- Voice Button (Grid.Column="2") -->
                    <Button Grid.Column="2" x:Name="VoiceButton" 
                            Content="🎤" 
                            Width="50" Height="40"
                            Click="VoiceButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AA00" 
                            BorderBrush="#9000AA00" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="20" 
                            Style="{StaticResource ButtonStyle}"/>

                    <!-- Send Button (Grid.Column="3") -->
                    <Button Grid.Column="3" 
                            Content="Send" 
                            Width="80" Height="40"
                            Click="SendButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- STATUS BAR (Grid.Row="4") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" Background="#40000000" CornerRadius="6" 
                       Padding="12,8" BorderBrush="#60FFFFFF" BorderThickness="1"
                       MouseDown="StatusBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator" Width="10" Height="10" 
                                    Fill="#00FF00" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="1.0" Color="#00FF00"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="✓ Protected | Two-cursor system active" 
                                      FontSize="12" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                        
                        <TextBlock x:Name="VoiceStatusText" Text="" 
                                  FontSize="12" Foreground="#FFD700" 
                                  HorizontalAlignment="Right" Effect="{StaticResource Shadow}"/>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- DEBUG PANEL (Grid.Row="5") - COLLAPSIBLE -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="5" x:Name="DebugPanel" 
                        Background="#50000000" BorderBrush="#70FF00FF" BorderThickness="2"
                        CornerRadius="8" Padding="10" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Debug Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🐛" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Debug Logs (Also Invisible!)" FontSize="14" FontWeight="Bold"
                                        Foreground="#FF00FF" Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔍 View Context" Width="100" Height="25" Click="ViewContextButton_Click"
                                    Background="#5000FFFF" BorderBrush="#9000FFFF" BorderThickness="1"
                                    Foreground="White" FontSize="11" Margin="0,0,5,0"
                                    Style="{StaticResource ButtonStyle}"/>
                                
                                <Button Content="📋 Copy" Width="70" Height="25" Click="CopyLogsButton_Click"
                                    Background="#50FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1"
                                    Foreground="White" FontSize="11" Margin="0,0,5,0"
                                    Style="{StaticResource ButtonStyle}"/>
                                <Button Content="🗑️ Clear" Width="70" Height="25" Click="ClearLogsButton_Click"
                                    Background="#50FF0000" BorderBrush="#90FF0000" BorderThickness="1"
                                    Foreground="White" FontSize="11"
                                    Style="{StaticResource ButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Debug Log Viewer -->
                        <Border Grid.Row="1" Background="#30000000" BorderBrush="#50FFFFFF" 
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ScrollViewer x:Name="DebugScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DebugLogsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" 
                                                      Foreground="#00FF00" FontFamily="Consolas" 
                                                      FontSize="11" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Auto-scroll toggle -->
                        <CheckBox Grid.Row="2" x:Name="AutoScrollCheckBox" 
                                 Content="Auto-scroll to latest" 
                                 Foreground="White" FontSize="11" Margin="0,8,0,0"
                                 IsChecked="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SETTINGS PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="SettingsPageContainer" Visibility="Collapsed">
            <ContentControl x:Name="SettingsPageHost"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM CURSOR CANVAS - TOP LAYER (Invisible to screen share!) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Canvas x:Name="CustomCursorCanvas" 
                IsHitTestVisible="False" 
                Background="Transparent"/>
    </Grid>
</Window>
