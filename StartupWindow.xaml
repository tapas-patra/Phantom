<Window x:Class="SecureOverlay.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0C1018">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#172336" Offset="0"/>
            <GradientStop Color="#0C1018" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageGlow}">
        <Border Margin="28" CornerRadius="22" Background="#CC101726" BorderBrush="#334A6484" BorderThickness="1.5">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Phantom" Foreground="White" FontSize="34" FontWeight="Bold"/>
                    <TextBlock Text="Desktop Access Gate" Foreground="#98B8D8" FontSize="15" Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,24,0,0" CornerRadius="18" Background="#AA111A2A" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="StateTitleText" Text="Welcome To Phantom" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="StateMessageText" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="15" LineHeight="23" Foreground="#D3E5F5"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="18" Background="#88101927" Padding="24" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="Login Methods" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="This scaffold keeps the flow local for now. Hosted auth and account validation will plug into the same gate seam next." TextWrapping="Wrap" Foreground="#9AB6D3" FontSize="13" Margin="0,10,0,18"/>

                            <TextBlock Text="Email" Foreground="#9AB6D3" FontSize="12"/>
                            <TextBox x:Name="EmailTextBox" Margin="0,8,0,14" Height="40" Padding="10,8" FontSize="14" Background="#E8F0F8" BorderThickness="0"/>

                            <TextBlock Text="Password" Foreground="#9AB6D3" FontSize="12"/>
                            <PasswordBox x:Name="PasswordTextBox" Margin="0,8,0,10" Height="40" Padding="10,8" FontSize="14" Background="#E8F0F8" BorderThickness="0"/>

                            <TextBlock x:Name="InlineStatusText" Foreground="#FFCC7A" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="18" Background="#5516283D" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Launch Rules" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Registration happens on the website. Login stays in-app. MainWindow stays blocked until startup checks pass." TextWrapping="Wrap" Foreground="#D3E5F5" FontSize="13" Margin="0,10,0,18"/>

                            <Border Background="#6620354D" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <TextBlock Text="Current implementation status: local stub mode. Use this gate to exercise the production startup flow without backend dependencies." TextWrapping="Wrap" Foreground="#D9E8F4" FontSize="12" LineHeight="18"/>
                            </Border>

                            <TextBlock x:Name="SafeModeText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFD89A" FontSize="12" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="LoginButton" Content="Login" Width="140" Background="#1976D2" Style="{StaticResource ActionButtonStyle}" Click="LoginButton_Click"/>
                    <Button x:Name="MagicLinkButton" Content="Magic Link" Width="140" Background="#2A4E77" Style="{StaticResource ActionButtonStyle}" Click="MagicLinkButton_Click"/>
                    <Button x:Name="RegisterButton" Content="Register On Website" Width="190" Background="#264653" Style="{StaticResource ActionButtonStyle}" Click="RegisterButton_Click"/>
                    <Button x:Name="RetryButton" Content="Retry" Width="120" Background="#5E6472" Style="{StaticResource ActionButtonStyle}" Click="RetryButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="ContinueButton" Content="Open App" Width="140" Background="#2A9D8F" Style="{StaticResource ActionButtonStyle}" Click="ContinueButton_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
