$env:PHANTOM_WINDOWS_BACKEND_DATABASE_URL = 'Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require'
$env:PHANTOM_WINDOWS_BACKEND_ADMIN_API_KEY = 'change-this-admin-key'

