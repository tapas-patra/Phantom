<Window x:Class="SecureOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Phantom" Height="500" Width="900" MinHeight="100" MinWidth="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Left="100" Top="100"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Cursor="Arrow"
        ForceCursor="True">
    
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="3" BlurRadius="10" Opacity="1" Color="Black"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Hidden WebView2 Container (for voice recognition) -->
        <Grid x:Name="WebView2Container" 
              Visibility="Visible"
              Opacity="0"
              IsHitTestVisible="False"
              ClipToBounds="False"
              Width="1" 
              Height="1"/>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CHAT PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ChatPageContainer" Visibility="Visible">
            <!-- Outer Shadow -->
            <Border x:Name="OuterShadowBorder" Background="Transparent" CornerRadius="14" Margin="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="35" Opacity="0.9" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Main Background -->
            <Border x:Name="WindowChromeBorder" Background="#96000000" CornerRadius="12" Margin="0"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown"
                    BorderBrush="Transparent" BorderThickness="0"/>

            <!-- Content -->
            <Grid x:Name="MainContentGrid" Margin="18,14,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title bar -->
                    <RowDefinition x:Name="ChatSectionRow" Height="*"/>     <!-- Chat section -->
                </Grid.RowDefinitions>


                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- TITLE BAR (Grid.Row="0") - ENHANCED WITH INTERACTIVE DROPDOWNS -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="TitleBarGrid" Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="-4,0,6,0" VerticalAlignment="Center">
                        <Border Background="#14253B52" BorderBrush="#334A6484" BorderThickness="1"
                                CornerRadius="12" Padding="4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Image Source="phantom-logo-512.png"
                                   Width="28"
                                   Height="28"
                                   Stretch="Uniform"/>
                        </Border>

                        <ComboBox x:Name="LiveModeComboBox" Width="92" Height="28" Margin="4,0,0,0"
                                  Visibility="Collapsed"
                                  Background="#FF202936" Foreground="White" BorderBrush="#667B8DA5"
                                  SelectionChanged="LiveModeComboBox_SelectionChanged"
                                  AutomationProperties.Name="Live Copilot mode">
                            <ComboBoxItem Content="Interview" Foreground="Black"/>
                            <ComboBoxItem Content="Briefing" Foreground="Black"/>
                        </ComboBox>
                        <!-- API Key Indicator -->
                        <Border x:Name="APIKeyIndicator" Background="#5000FF00" CornerRadius="4" 
                                Padding="6,2" Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="APIKeyText" Text="K1" FontSize="9" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="CreditIndicatorBorder" Background="#506A4C1F" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CreditIndicatorText" Text="Cr --" FontSize="9"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="ActiveCreditModeBorder" Background="#50505050" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveCreditModeText" Text="Idle" FontSize="9"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="SessionTimerBorder" Background="#503A245D" CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="SessionTimerText" Text="T 00:00:00" FontSize="9"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border x:Name="TokenCounterBorder" Background="#5000AAFF" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="TokenCounterText" Text="0k/8k" FontSize="9" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </Border>

                        <Border Background="#30404A58" CornerRadius="6" Padding="7,4" Margin="6,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Opacity" FontSize="10" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                           Effect="{StaticResource Shadow}"/>
                                <Slider x:Name="HeaderOpacitySlider"
                                        Width="76"
                                        Minimum="0.30"
                                        Maximum="1.20"
                                        Value="0.92"
                                        ValueChanged="HeaderOpacitySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CollapsedHeaderMicButton" Content="🎤" Width="40" Height="32" Click="VoiceButton_Click"
                            Background="#5000AA00" BorderBrush="#9000AA00" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Style="{StaticResource ButtonStyle}"/>

                        <Button x:Name="ChatCollapseButton" Content="▴" Width="40" Height="32" Click="ChatCollapseButton_Click"
                            Background="#50505050" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>

                        <Button x:Name="LegacyFallbackButton" Content="Legacy" Width="70" Height="32" Click="LegacyFallbackButton_Click"
                            Background="#505A3A24" BorderBrush="#90D7C46B" BorderThickness="1.5"
                            Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>

                        <!-- AUTO-RESTART BUTTON -->
                        <Button Content="🔄" Width="40" Height="32" Click="RestartButton_Click"
                            Background="#50FF6B00" BorderBrush="#90FF6B00" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>

                        <!-- NEW TOPIC BUTTON -->
                        <Button Content="📝" Width="40" Height="32" Click="NewTopicButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <!-- CLEAR CHAT BUTTON -->
                        <Button Content="🔃" Width="40" Height="32" Click="ClearChatButton_Click"
                            Background="#50FFA500" BorderBrush="#90FFA500" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>

                        <Button Content="📋" Width="40" Height="32" Click="CopyChatButton_Click"
                            Background="#504B76A8" BorderBrush="#9073B8FF" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>

                        <Button x:Name="ClickThroughButton" Width="40" Height="32" Click="ClickThroughButton_Click"
                            Background="#50505050" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" Margin="0,0,8,0"
                            AutomationProperties.Name="Enable click-through"
                            Style="{StaticResource ButtonStyle}">
                            <Viewbox Width="17" Height="17">
                                <Path Data="M3,2 L3,22 L8.8,16.5 L13.2,25 L17,23 L12.7,15 L21,15 Z"
                                      Fill="White" Stroke="#CCFFFFFF" StrokeThickness="0.8"/>
                            </Viewbox>
                        </Button>
                        
                        <Button Content="⚙️" Width="40" Height="32" Click="SettingsButton_Click"
                            Background="#5000AAFF" BorderBrush="#9000AAFF" BorderThickness="1.5"
                            Foreground="White" FontSize="16" Margin="0,0,8,0" 
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="–" Width="40" Height="32" Click="MinimizeButton_Click"
                            Background="#55FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1.5"
                            Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}"/>
                        
                        <Button Content="✕" Width="40" Height="32" Click="CloseButton_Click"
                            Background="#55FF4444" BorderBrush="#90FF4444" BorderThickness="1.5"
                            Foreground="White" FontSize="16" FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                    </StackPanel>
                </Grid>

                
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- STATUS BANNERS (Grid.Row="1") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="ChatSectionContainer" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border x:Name="LaunchRestrictionBanner"
                            Background="#50FFB000" CornerRadius="6"
                            Padding="10" Margin="0,0,0,10"
                            Visibility="Collapsed"
                            BorderBrush="#90FFB000" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="LaunchRestrictionTitle"
                                           Text="Restricted Session"
                                           FontSize="13" FontWeight="Bold" Foreground="White"
                                           Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="LaunchRestrictionDetails"
                                           Text="Interview actions are currently blocked."
                                           TextWrapping="Wrap"
                                           FontSize="10" Foreground="#FFF0D0"
                                           Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DebugModeWarning"
                            Background="#50FF0000" CornerRadius="6"
                            Padding="10" Margin="0,0,0,10"
                            Visibility="Collapsed"
                            BorderBrush="#90FF0000" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" FontSize="20" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="DebugModeText"
                                           Text="DEBUG MODE: Simulating API Errors"
                                           FontSize="13" FontWeight="Bold" Foreground="White"
                                           Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="DebugModeDetails"
                                           Text="Mode: None | Requests: 0"
                                           FontSize="10" Foreground="#FFCCCC"
                                           Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- CHAT DISPLAY (Grid.Row="1") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Background="#40000000" BorderBrush="#70FFFFFF" 
                        BorderThickness="1.5" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                        MouseDown="ChatArea_MouseDown"
                        Cursor="Arrow"
                        ForceCursor="True">
                    <wv2:WebView2 x:Name="ChatWebView"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
                </Border>

                <!-- INPUT AREA (Grid.Row="2") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,12" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/> <!-- Input box -->
                        <ColumnDefinition Width="Auto"/>   <!-- Screenshot button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Provider button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Model button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Voice button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Regenerate button -->
                        <ColumnDefinition Width="Auto"/>   <!-- Send button -->
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="ClarificationOptionsPanel" Grid.Row="0" Grid.ColumnSpan="7"
                                Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- Mac-style attached screenshot strip above the composer -->
                    <Border x:Name="AttachedScreenshotsBorder"
                            Grid.Row="1" Grid.ColumnSpan="7"
                            Background="#2000AAFF"
                            CornerRadius="9"
                            Padding="8"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ClearAttachedScreenshotsButton"
                                    DockPanel.Dock="Right"
                                    Content="Clear"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    FontSize="11"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearAttachedScreenshotsButton_Click"/>
                            <TextBlock x:Name="AttachedScreenshotsCountText"
                                       DockPanel.Dock="Right"
                                       Text="0/3"
                                       FontSize="11"
                                       Foreground="#AAFFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                            <StackPanel x:Name="AttachedScreenshotsPanel"
                                        Orientation="Horizontal"/>
                        </DockPanel>
                    </Border>

                    <!-- Input Text Box -->
                    <Border Grid.Row="2" Grid.Column="0" Background="#40000000" BorderBrush="#70FFFFFF"
                            BorderThickness="1.5" CornerRadius="8" Padding="12,8"
                            MouseDown="InputBorder_MouseDown"
                            x:Name="InputBorder"
                            Cursor="Arrow"
                            ForceCursor="True">
                        <TextBox x:Name="InputTextBox" 
                                Background="Transparent" 
                                BorderThickness="0"
                                Foreground="White" 
                                FontSize="14" 
                                CaretBrush="White"
                                VerticalAlignment="Stretch"
                                Effect="{StaticResource Shadow}"
                                PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                PreviewMouseDown="InputTextBox_PreviewMouseDown"
                                Text="Ask me anything..."
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                MaxHeight="150"
                                Cursor="Arrow"
                                ForceCursor="True">
                            <TextBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste"/>
                            </TextBox.CommandBindings>
                        </TextBox>
                    </Border>

                    <!-- Screenshot Button (Grid.Column="1") -->
                    <Button Grid.Row="2" Grid.Column="1" x:Name="ScreenshotButton"
                            Width="50" Height="40"
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="18"
                            Style="{StaticResource ButtonStyle}"
                            Click="ScreenshotButton_Click"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ScreenshotButtonText" Text="📸" FontSize="18"/>
                    </Button>

                    <Border Grid.Row="2" Grid.Column="2" Background="#50FFD700" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                            Cursor="Arrow" ForceCursor="True" MouseLeftButtonDown="ProviderSelector_Click"
                            x:Name="ProviderSelectorBorder" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AIProviderText" Text="ChatGPT" FontSize="11" 
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                            <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="3" Background="#5000AAFF" CornerRadius="6" Padding="8,4" Margin="10,0,0,0"
                            Cursor="Arrow" ForceCursor="True" MouseLeftButtonDown="ModelSelector_Click"
                            x:Name="ModelSelectorBorder" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModelText" Text="" FontSize="11" MaxWidth="92" TextTrimming="CharacterEllipsis"
                                    FontWeight="Bold" Foreground="White" Effect="{StaticResource Shadow}"/>
                            <TextBlock Text=" ▼" FontSize="9" Foreground="White" Margin="4,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Voice Button (Grid.Column="4") -->
                    <Button Grid.Row="2" Grid.Column="4" x:Name="VoiceButton"
                            Content="🎤" 
                            Width="50" Height="40"
                            Click="VoiceButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AA00" 
                            BorderBrush="#9000AA00" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="20" 
                            Style="{StaticResource ButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="5" x:Name="RegenerateButton"
                            Width="42" Height="40"
                            Click="RegenerateButton_Click"
                            Margin="10,0,0,0"
                            Background="#503B82F6"
                            BorderBrush="#9073B8FF"
                            BorderThickness="1.5"
                            Foreground="White"
                            IsEnabled="False"
                            AutomationProperties.Name="Regenerate last answer"
                            Style="{StaticResource ButtonStyle}">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M3,12 A9,9 0 1 0 6,5.3 M3,3 L3,8 L8,8"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"/>
                        </Viewbox>
                    </Button>

                    <!-- Send Button (Grid.Column="6") -->
                    <Button Grid.Row="2" Grid.Column="6" x:Name="SendButton"
                            Content="➜" 
                            Width="42" Height="40"
                            Click="SendButton_Click" 
                            Margin="10,0,0,0"
                            Background="#5000AAFF" 
                            BorderBrush="#9000AAFF" 
                            BorderThickness="1.5"
                            Foreground="White" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Style="{StaticResource ButtonStyle}"/>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- STATUS BAR (Grid.Row="3") -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="3" Background="#40000000" CornerRadius="6" 
                       Padding="12,8" BorderBrush="#60FFFFFF" BorderThickness="1"
                       MouseDown="StatusBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator" Width="10" Height="10" 
                                    Fill="#00FF00" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="1.0" Color="#00FF00"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="✓ Protected | Two-cursor system active" 
                                      FontSize="12" Foreground="White" Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SessionStatusText" Text="" 
                                      FontSize="12" Foreground="#71D9D7" Margin="0,0,12,0"
                                      Effect="{StaticResource Shadow}"/>
                            <TextBlock x:Name="VoiceStatusText" Text="" 
                                      FontSize="12" Foreground="#FFD700" 
                                      Effect="{StaticResource Shadow}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                </Grid>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SETTINGS PAGE -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="SettingsPageContainer" Visibility="Collapsed">
            <ContentControl x:Name="SettingsPageHost"/>
        </Grid>

        <Thumb Width="8" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Left"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="8" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Right"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Height="8" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Top"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Height="8" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="Bottom"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="TopLeft"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="TopRight"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="BottomLeft"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Style="{StaticResource ResizeThumbStyle}" Cursor="Arrow" ForceCursor="True" Tag="BottomRight"
               DragDelta="ResizeThumb_DragDelta"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM CURSOR CANVAS - TOP LAYER (Invisible to screen share!) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Canvas x:Name="CustomCursorCanvas" 
                IsHitTestVisible="False" 
                Background="Transparent"/>
    </Grid>
</Window>
