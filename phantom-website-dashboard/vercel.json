{
  "rewrites": [
    {
      "source": "/api/windows/:path*",
      "destination": "https://phantom-ai-windows-app-backend.onrender.com/:path*"
    },
    {
      "source": "/api/dashboard-backend/:path*",
      "destination": "https://phantom-dashboard-backend.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
