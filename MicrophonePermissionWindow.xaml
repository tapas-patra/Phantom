<Window x:Class="SecureOverlay.MicrophonePermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Grant Microphone Permission" 
        Height="450" Width="650"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="2" BlurRadius="8" Color="Black"/>
    </Window.Resources>
    
    <Grid>
        <Border Background="#70000000" CornerRadius="12" BorderBrush="#90FFFFFF" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.9" Color="Black"/>
            </Border.Effect>
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="🎤 Microphone Permission Required" 
                              FontSize="18" FontWeight="Bold" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Click the button below, then click 'Allow' in the browser prompt" 
                              FontSize="12" Foreground="#CCCCCC" Margin="0,5,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <Border Grid.Row="1" Background="#20FFFFFF" CornerRadius="8" 
                       BorderBrush="#60FFFFFF" BorderThickness="1">
                    <wv2:WebView2 x:Name="PermissionWebView" />
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                           HorizontalAlignment="Right" Margin="0,15,0,0">
                    <TextBlock x:Name="StatusText" Text="Loading..." 
                              Foreground="White" VerticalAlignment="Center" 
                              Margin="0,0,20,0" FontSize="12"/>
                    <Button Content="Cancel" Width="100" Height="35" 
                           Click="CancelButton_Click"
                           Background="#50AA0000" BorderBrush="#90AA0000" 
                           BorderThickness="1.5" Foreground="White" 
                           FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
