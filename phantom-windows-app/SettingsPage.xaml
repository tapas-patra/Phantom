<UserControl x:Class="SecureOverlay.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="3" BlurRadius="10" Opacity="1" Color="Black"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown">
        <Border Background="#78000000" CornerRadius="12" BorderBrush="Transparent" BorderThickness="0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.9" Color="Black"/>
            </Border.Effect>
            
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="⚙️ Settings" FontSize="20" FontWeight="Bold" 
                          Foreground="White" Margin="0,0,0,20" Effect="{StaticResource Shadow}"/>

                <!-- Settings Content -->
                <ScrollViewer x:Name="SettingsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False"
                              PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                    <StackPanel>
                        
                        <Border x:Name="PremiumManagedNotice" Background="#503A245D" CornerRadius="8"
                               Padding="15" Margin="0,0,0,15" Visibility="Collapsed"
                               BorderBrush="#9071D9D7" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock x:Name="PremiumManagedNoticeTitle" Text="Premium Managed AI" FontSize="14" FontWeight="Bold"
                                          Foreground="White" Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="PremiumManagedNoticeBody" Text="Premium accounts use Phantom-managed provider keys. Provider and model can still be switched from the main window, but API key setup stays hidden."
                                          TextWrapping="Wrap" FontSize="12" Foreground="#D8EEF0" Margin="0,8,0,0"
                                          Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="FreeTrialNotice" Background="#50456A21" CornerRadius="8"
                               Padding="15" Margin="0,0,0,15" Visibility="Collapsed"
                               BorderBrush="#90D7C46B" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="Free Trial Mode" FontSize="14" FontWeight="Bold"
                                          Foreground="White" Effect="{StaticResource Shadow}"/>
                                <TextBlock Text="This tier uses Phantom-managed trial access. Provider and model can be switched from the main window, but API key setup stays hidden until the account upgrades to Pro BYO."
                                          TextWrapping="Wrap" FontSize="12" Foreground="#F7EFCF" Margin="0,8,0,0"
                                          Effect="{StaticResource Shadow}"/>
                                <TextBlock Text="Trial allowance: 2 hosted 15-minute demo blocks."
                                          TextWrapping="Wrap" FontSize="12" Foreground="#F7EFCF" Margin="0,6,0,0"
                                          Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SessionContinuationNotice" Background="#303C5060" CornerRadius="8"
                               Padding="15" Margin="0,0,0,15" Visibility="Collapsed"
                               BorderBrush="#9071D9D7" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock x:Name="SessionContinuationTitle" Text="Session Extension"
                                          FontSize="14" FontWeight="Bold" Foreground="White"
                                          Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="SessionContinuationDescription"
                                          TextWrapping="Wrap" FontSize="12" Foreground="#D8EEF0"
                                          Margin="0,8,0,10" Effect="{StaticResource Shadow}"/>
                                <CheckBox x:Name="SessionContinuationCheckBox"
                                         Content="Allow session extension beyond the first 15-minute block"
                                         Foreground="White" FontSize="13"/>
                                <CheckBox x:Name="BillingPriorityCheckBox"
                                         Content="When both Premium and BYO credits are available, use BYO first"
                                         Foreground="White" FontSize="13" Margin="0,10,0,0"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="KnowledgeBaseStatusNotice" Background="#30304B2A" CornerRadius="8"
                               Padding="15" Margin="0,0,0,15" Visibility="Collapsed"
                               BorderBrush="#90D7C46B" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock x:Name="KnowledgeBaseStatusTitle" Text="Premium Knowledge Base"
                                          FontSize="14" FontWeight="Bold" Foreground="White"
                                          Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="KnowledgeBaseStatusBody"
                                          TextWrapping="Wrap" FontSize="12" Foreground="#F7EFCF"
                                          Margin="0,8,0,0" Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ByoConfigurationSection">
                        <!-- AI Provider Selection -->
                        <StackPanel x:Name="ProviderSelectionSection">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="AI Provider" FontSize="14" FontWeight="Bold"
                                          Foreground="White" VerticalAlignment="Center"
                                          Effect="{StaticResource Shadow}"/>
                                <Button x:Name="RefreshByoCatalogButton"
                                       Content="Refresh models"
                                       Width="120" Height="28"
                                       HorizontalAlignment="Right"
                                       Click="RefreshByoCatalogButton_Click"
                                       Background="#5000AAFF" BorderBrush="#9000AAFF" BorderThickness="1"
                                       Foreground="White" FontSize="11"
                                       Style="{StaticResource ButtonStyle}"/>
                            </Grid>
                            <TextBlock x:Name="ByoCatalogStatusText"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#B8D4E8"
                                       Margin="0,0,0,10"
                                       Visibility="Collapsed"
                                       Effect="{StaticResource Shadow}"/>
                            <ComboBox x:Name="AIProviderComboBox" Height="35" Margin="0,0,0,20"
                                     FontSize="14" SelectionChanged="AIProviderComboBox_SelectionChanged"
                                     Foreground="Black"/>
                        </StackPanel>
                        <StackPanel x:Name="PremiumManagedModelRow" Visibility="Collapsed" Margin="0,0,0,20">
                            <TextBlock Text="Managed Model" FontSize="12" Foreground="White" Margin="0,0,0,6" Effect="{StaticResource Shadow}"/>
                            <ComboBox x:Name="ManagedModelComboBox" Height="35" FontSize="13" Foreground="Black"/>
                        </StackPanel>

                        <!-- ChatGPT Settings -->
                        <Border x:Name="ChatGPTPanel" Background="#30FFFFFF" CornerRadius="8" 
                               Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="ChatGPT Configuration" FontSize="13" FontWeight="Bold" 
                                          Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                
                                <!-- API Keys -->
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="ChatGPTKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveChatGPTKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddChatGPTKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <!-- Models -->
                                <TextBlock Text="Models (in order of preference):" Foreground="White" 
                                          Margin="0,5,0,5" FontSize="12" Effect="{StaticResource Shadow}"/>
                                <TextBlock Text="First model is used by default. Others are fallbacks." 
                                          FontSize="10" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ChatGPTModelBox" Height="30" SelectionChanged="ChatGPTModelBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Claude Settings -->
                        <Border x:Name="ClaudePanel" Background="#30FFFFFF" CornerRadius="8" 
                               Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Claude Configuration" FontSize="13" FontWeight="Bold" 
                                          Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="ClaudeKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveClaudeKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddClaudeKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <TextBlock Text="Model:" Foreground="White" Margin="0,5,0,5" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="ClaudeModelBox" Height="30" SelectionChanged="ClaudeModelBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Mistral Settings -->
                        <Border x:Name="MistralPanel" Background="#30FFFFFF" CornerRadius="8" 
                               Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Mistral Configuration" FontSize="13" FontWeight="Bold" 
                                          Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="MistralKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveMistralKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddMistralKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <TextBlock Text="Model:" Foreground="White" Margin="0,5,0,5" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="MistralModelBox" Height="30" SelectionChanged="MistralModelBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <!-- Gemini Settings -->
                        <Border x:Name="GeminiPanel" Background="#30FFFFFF" CornerRadius="8" 
                            Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Gemini Configuration" FontSize="13" FontWeight="Bold" 
                                        Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap" Effect="{StaticResource Shadow}">
                                    <Run Text="Get your API key from: "/>
                                    <Hyperlink NavigateUri="https://aistudio.google.com/app/apikey" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="Google AI Studio"/>
                                    </Hyperlink>
                                </TextBlock>
                                
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="GeminiKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveGeminiKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddGeminiKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <TextBlock Text="Model:" Foreground="White" Margin="0,5,0,5" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="GeminiModelBox" Height="30" SelectionChanged="GeminiModelBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Groq Settings -->
                        <Border x:Name="GroqPanel" Background="#30FFFFFF" CornerRadius="8" 
                            Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Groq Configuration" FontSize="13" FontWeight="Bold" 
                                        Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap" Effect="{StaticResource Shadow}">
                                    <Run Text="Get your API key from: "/>
                                    <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="Groq Console"/>
                                    </Hyperlink>
                                    <LineBreak/>
                                    <Run Text="⚡ Ultra-fast inference (up to 700 tokens/sec!)"/>
                                </TextBlock>
                                
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="GroqKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveGroqKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddGroqKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <TextBlock Text="Model:" Foreground="White" Margin="0,5,0,5" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="GroqModelBox" Height="30" SelectionChanged="GroqModelBox_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- NVIDIA Settings -->
                        <Border x:Name="NvidiaPanel" Background="#30FFFFFF" CornerRadius="8" 
                            Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="NVIDIA Configuration" FontSize="13" FontWeight="Bold" 
                                        Foreground="White" Margin="0,0,0,10" Effect="{StaticResource Shadow}"/>
                                <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap" Effect="{StaticResource Shadow}">
                                    <Run Text="Get your API key from: "/>
                                    <Hyperlink NavigateUri="https://build.nvidia.com/" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="NVIDIA Build"/>
                                    </Hyperlink>
                                </TextBlock>
                                
                                <TextBlock Text="API Keys:" Foreground="White" Margin="0,0,0,5" Effect="{StaticResource Shadow}"/>
                                <ItemsControl x:Name="NvidiaKeysList" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="35"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" 
                                                          Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="30" Background="#40FFFFFF" 
                                                        Foreground="White" BorderBrush="#70FFFFFF"
                                                        BorderThickness="1" Padding="5"/>
                                                
                                                <Button Grid.Column="2" Content="✕" Width="30" Height="30"
                                                       Click="RemoveNvidiaKey_Click" Tag="{Binding}"
                                                       Background="#50FF0000" BorderBrush="#90FF0000" 
                                                       BorderThickness="1" Foreground="White" Margin="5,0,0,0"
                                                       Style="{StaticResource ButtonStyle}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <Button Content="+ Add API Key" Click="AddNvidiaKey_Click"
                                       Height="30" Background="#5000AA00" BorderBrush="#9000AA00"
                                       BorderThickness="1" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Left" Margin="0,0,0,15"
                                       Style="{StaticResource ButtonStyle}"/>
                                
                                <TextBlock Text="Model:" Foreground="White" Margin="0,5,0,5" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="NvidiaModelBox" Height="30" />
                            </StackPanel>
                        </Border>

                        <!-- API Rotation Settings -->
                        <TextBlock Text="🔄 API Rotation Settings" FontSize="14" FontWeight="Bold" 
                                  Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox x:Name="AutoSwitchKeysCheckBox" 
                                         Content="Auto-switch API keys on rate limit (429 errors)" 
                                         Foreground="White" FontSize="13" Margin="0,0,0,10"
                                         IsChecked="True"/>
                                
                                <CheckBox x:Name="AutoSwitchModelsCheckBox" 
                                         Content="Auto-switch models on other errors (after 1 retry)" 
                                         Foreground="White" FontSize="13"
                                         IsChecked="True"/>
                                
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#AAAAAA" Margin="0,10,0,0"
                                          Effect="{StaticResource Shadow}">
                                    <Run Text="Strategy:"/>
                                    <LineBreak/>
                                    <Run Text="• 429 Error → Switch key → Retry immediately"/>
                                    <LineBreak/>
                                    <Run Text="• Other Error → Retry once → Switch model → Retry"/>
                                    <LineBreak/>
                                    <Run Text="• Priority: Key switching → Model switching"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <TextBlock Text="Live Copilot" FontSize="14" FontWeight="Bold"
                                  Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <TextBlock Text="Choose Interview or Briefing. Phantom detects the answer shape on every turn; Desi changes delivery only."
                                  FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap" Effect="{StaticResource Shadow}"/>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mode" Foreground="White" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CopilotModeComboBox" Background="White" Foreground="Black" BorderThickness="0" FontSize="12">
                                        <ComboBoxItem Content="Interview"/>
                                        <ComboBoxItem Content="Briefing"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Interview delivery" Foreground="White" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="DeliveryStyleComboBox" Background="White" Foreground="Black" BorderThickness="0" FontSize="12">
                                        <ComboBoxItem Content="Standard"/>
                                        <ComboBoxItem Content="Desi — Natural Indian English" Tag="Desi"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Auto Pause -->
                        <TextBlock Text="Session Auto Pause" FontSize="14" FontWeight="Bold"
                                  Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox x:Name="AutoPauseInactivityCheckBox"
                                         Content="Pause the interview after inactivity"
                                         Foreground="White"
                                         FontSize="13"
                                         Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Idle minutes:"
                                              Foreground="White"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    <TextBox x:Name="AutoPauseMinutesTextBox"
                                             Width="60"
                                             Text="10"
                                             Background="#40FFFFFF"
                                             Foreground="White"
                                             BorderThickness="0"
                                             Padding="6,4"/>
                                    <TextBlock Text="(minimum 10)"
                                              Foreground="#CCCCCC"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LegacyFallbackHeading" Text="Legacy Fallback App" FontSize="14" FontWeight="Bold"
                                  Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <Border x:Name="LegacyFallbackPanel" Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Choose the legacy Phantom app executable. The main window can hand off to it if the hosted app fails."
                                          FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap"
                                          Effect="{StaticResource Shadow}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LegacyFallbackAppPathTextBox"
                                             Grid.Column="0"
                                             Height="35"
                                             Background="#40FFFFFF"
                                             Foreground="White"
                                             BorderBrush="#70FFFFFF"
                                             BorderThickness="1"
                                             Padding="8,4"/>
                                    <Button Grid.Column="1"
                                            Content="Browse"
                                            Width="90"
                                            Height="35"
                                            Click="BrowseLegacyFallbackAppPathButton_Click"
                                            Margin="10,0,0,0"
                                            Background="#50406080"
                                            BorderBrush="#9071D9D7"
                                            BorderThickness="1.5"
                                            Foreground="White"
                                            Style="{StaticResource ButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ContextPackSection" Background="#303A245D" CornerRadius="8"
                               Padding="15" Margin="0,0,0,15" Visibility="Collapsed"
                               BorderBrush="#9071D9D7" BorderThickness="1.5">
                            <StackPanel>
                                <TextBlock Text="Premium Context Packs" FontSize="14" FontWeight="Bold"
                                          Foreground="White" Effect="{StaticResource Shadow}"/>
                                <TextBlock x:Name="ContextPackSectionDescription"
                                          Text="Save full resume and job-description pairs to your Premium account, then reload them later by name."
                                          TextWrapping="Wrap" FontSize="12" Foreground="#D8EEF0"
                                          Margin="0,8,0,12" Effect="{StaticResource Shadow}"/>

                                <TextBlock Text="Saved Pack" FontSize="12" Foreground="White"
                                          Margin="0,0,0,6" Effect="{StaticResource Shadow}"/>
                                <ComboBox x:Name="SavedContextPackComboBox"
                                         Height="35"
                                         Margin="0,0,0,10"
                                         Foreground="Black"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="SavedContextPackComboBox_SelectionChanged"/>

                                <TextBlock Text="Pack Name" FontSize="12" Foreground="White"
                                          Margin="0,0,0,6" Effect="{StaticResource Shadow}"/>
                                <TextBox x:Name="ContextPackNameTextBox"
                                        Height="35"
                                        Margin="0,0,0,10"
                                        Background="#40FFFFFF"
                                        Foreground="White"
                                        BorderBrush="#70FFFFFF"
                                        BorderThickness="1"
                                        Padding="8,4"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="SaveContextPackButton"
                                           Content="Save Pack"
                                           Width="110"
                                           Height="32"
                                           Click="SaveContextPackButton_Click"
                                           Background="#505A9B2D"
                                           BorderBrush="#90A7D76B"
                                           BorderThickness="1"
                                           Foreground="White"
                                           Style="{StaticResource ButtonStyle}"/>
                                    <Button x:Name="EditContextPackButton"
                                           Content="Edit Pack"
                                           Width="110"
                                           Height="32"
                                           Margin="10,0,0,0"
                                           Click="EditContextPackButton_Click"
                                           Background="#50406D9C"
                                           BorderBrush="#908BBBE8"
                                           BorderThickness="1"
                                           Foreground="White"
                                           Style="{StaticResource ButtonStyle}"/>
                                    <Button x:Name="DeleteContextPackButton"
                                           Content="Delete Pack"
                                           Width="110"
                                           Height="32"
                                           Margin="10,0,0,0"
                                           Click="DeleteContextPackButton_Click"
                                           Background="#505D2C2C"
                                           BorderBrush="#90E28A8A"
                                           BorderThickness="1"
                                           Foreground="White"
                                           Style="{StaticResource ButtonStyle}"/>
                                </StackPanel>

                                <TextBlock x:Name="ContextPackStatusText"
                                          Text=""
                                          TextWrapping="Wrap"
                                          FontSize="11"
                                          Foreground="#F7EFCF"
                                          Effect="{StaticResource Shadow}"/>
                            </StackPanel>
                        </Border>

                        <!-- Resume -->
                        <TextBlock Text="📄 Resume / Professional Profile" FontSize="14" FontWeight="Bold" 
                                  Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" Effect="{StaticResource Shadow}">
                            <Run Text="Provide your resume for personalized AI responses."/>
                            <LineBreak/>
                            <Run Text="• Limit: 1200 words maximum"/>
                            <LineBreak/>
                            <Run Text="• AI will summarize it once and use it for context"/>
                            <LineBreak/>
                            <Run Text="• Summary is cached - no need to re-enter"/>
                        </TextBlock>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBox x:Name="ResumeBox" 
                                         Grid.Row="0"
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         Height="120" 
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontSize="12"
                                         TextChanged="ResumeBox_TextChanged"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="ResumeWordCount" 
                                              Text="Words: 0 / 1200" 
                                              Foreground="#AAAAAA" 
                                              FontSize="10"/>
                                    <TextBlock x:Name="ResumeSummaryStatus" 
                                              Text="" 
                                              Foreground="#FFD700" 
                                              FontSize="10"
                                              Margin="15,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Job Description -->
                        <TextBlock Text="💼 Job Description" FontSize="14" FontWeight="Bold" 
                                Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" Effect="{StaticResource Shadow}">
                            <Run Text="Paste the job description you're interviewing for."/>
                            <LineBreak/>
                            <Run Text="• Limit: 450 words maximum"/>
                            <LineBreak/>
                            <Run Text="• AI will provide interview-specific guidance"/>
                            <LineBreak/>
                            <Run Text="• Cleared when starting new topic or closing app"/>
                        </TextBlock>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBox x:Name="JobDescriptionBox" 
                                        Grid.Row="0"
                                        TextWrapping="Wrap" 
                                        AcceptsReturn="True"
                                        Height="120" 
                                        VerticalScrollBarVisibility="Auto"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        TextChanged="JobDescriptionBox_TextChanged"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="JobDescriptionWordCount" 
                                            Text="Words: 0 / 450" 
                                            Foreground="#AAAAAA" 
                                            FontSize="10"/>
                                    <TextBlock x:Name="JobDescriptionSummaryStatus" 
                                            Text="" 
                                            Foreground="#FFD700" 
                                            FontSize="10"
                                            Margin="15,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Voice Input -->
                        <CheckBox x:Name="VoiceInputCheckBox" Content="Enable Voice Input" 
                                 Foreground="White" FontSize="14" Margin="0,10,0,12"/>
                        <CheckBox x:Name="AutoSendAfterVoiceStopCheckBox"
                                 Content="Auto-send after stopping the microphone"
                                 Foreground="White" FontSize="13" Margin="0,0,0,20"/>

                        <Border x:Name="SpeechModelsSection" Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Speech Models" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SpeechRuntimeNotice" TextWrapping="Wrap" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                                <StackPanel x:Name="SpeechModePanel">
                                    <TextBlock Text="Recognizer" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="SpeechModeComboBox" Height="30" SelectionChanged="SpeechModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Native"/>
                                        <ComboBoxItem Content="Cloud"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="SpeechCloudOptions" Margin="0,10,0,0">
                                    <TextBlock Text="Provider" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="SpeechProviderComboBox" Height="30" SelectionChanged="SpeechProviderComboBox_SelectionChanged"/>
                                    <TextBlock Text="Model" Foreground="White" FontSize="12" Margin="0,10,0,4"/>
                                    <ComboBox x:Name="SpeechModelComboBox" Height="30"/>
                                    <TextBlock Text="Language (ISO-639-1)" Foreground="White" FontSize="12" Margin="0,10,0,4"/>
                                    <TextBox x:Name="SpeechLanguageTextBox" Height="28" Text="en"/>
                                    <CheckBox x:Name="UseChatKeysForSpeechCheckBox" Content="Use chat provider API keys" Foreground="White" Margin="0,12,0,8" Checked="UseChatKeysForSpeechCheckBox_Changed" Unchecked="UseChatKeysForSpeechCheckBox_Changed"/>
                                    <StackPanel x:Name="DedicatedSpeechKeysPanel">
                                        <PasswordBox x:Name="SpeechApiKeyOneBox" Height="28" Margin="0,0,0,6" ToolTip="Dedicated speech API key #1"/>
                                        <PasswordBox x:Name="SpeechApiKeyTwoBox" Height="28" ToolTip="Dedicated speech API key #2 (optional)"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SpeechNativeFallbackCheckBox" Content="Automatically fall back to native recognition on provider errors or exhausted credit" Foreground="White" Margin="0,12,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SpeechCatalogHintText"
                                           Text="Model choices are fetched from the Phantom backend catalog; BYO audio still goes directly to your selected provider."
                                           TextWrapping="Wrap" FontSize="10" Foreground="#AAAAAA" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Click-through -->
                        <TextBlock Text="Window Interaction" FontSize="14" FontWeight="Bold"
                                   Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <CheckBox x:Name="ClickThroughCheckBox"
                                  Content="Allow clicks to pass through Phantom"
                                  Foreground="White" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Text="Applied after Save. Press Ctrl+Alt+= to reopen Settings, which safely disables click-through."
                                   Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,20"
                                   Effect="{StaticResource Shadow}"/>

                        <!-- Fake Cursor Settings -->
                        <TextBlock Text="Fake Cursor Settings" FontSize="14" FontWeight="Bold" 
                                Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <TextBlock FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10" TextWrapping="Wrap" Effect="{StaticResource Shadow}">
                            <Run Text="Fake cursor appears at entry point (visible to screen share) while you interact with overlay."/>
                        </TextBlock>

                        <CheckBox x:Name="UseFakeCursorCheckBox" Content="Enable Fake Cursor (recommended)" 
                                Foreground="White" FontSize="13" Margin="0,0,0,15"
                                Checked="UseFakeCursorCheckBox_Changed" Unchecked="UseFakeCursorCheckBox_Changed"/>

                        <Border x:Name="FakeCursorSizePanel" Background="#30FFFFFF" CornerRadius="8" 
                            Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Fake Cursor Size:" Foreground="White" 
                                            FontSize="13" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="FakeCursorSizeTextBox" 
                                                Width="60" Height="25"
                                                Background="#40FFFFFF" 
                                                Foreground="White" 
                                                BorderBrush="#70FFFFFF"
                                                BorderThickness="1"
                                                VerticalContentAlignment="Center"
                                                HorizontalContentAlignment="Center"
                                                FontSize="12"
                                                Text="100"
                                                TextChanged="FakeCursorSizeTextBox_TextChanged"
                                                PreviewTextInput="FakeCursorSizeTextBox_PreviewTextInput"/>
                                        <TextBlock Text="%" Foreground="#FFD700" FontSize="13" 
                                                FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Slider x:Name="FakeCursorSizeSlider" 
                                        Minimum="50" Maximum="200" Value="100" 
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,0,0,10"
                                        ValueChanged="FakeCursorSizeSlider_ValueChanged"
                                        MouseEnter="FakeCursorSizeSlider_MouseEnter"
                                        MouseLeave="FakeCursorSizeSlider_MouseLeave"/>
                                
                                <Grid>
                                    <TextBlock Text="50%" FontSize="9" Foreground="#888888" 
                                            HorizontalAlignment="Left"/>
                                    <TextBlock Text="100%" FontSize="9" Foreground="#888888" 
                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="200%" FontSize="9" Foreground="#888888" 
                                            HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <TextBlock Text="Hover over slider to preview cursor | Type exact percentage above" 
                                        FontSize="10" Foreground="#AAAAAA" 
                                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="DebugModeSection">
                        <TextBlock Text="🧪 Debug Mode (Testing)" FontSize="14" FontWeight="Bold" 
                                Foreground="White" Margin="0,20,0,10" Effect="{StaticResource Shadow}"/>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox x:Name="DebugModeCheckBox" 
                                        Content="Enable API Error Simulation (for testing rotation)" 
                                        Foreground="White" FontSize="13" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Error Type:" Foreground="White" FontSize="12" Margin="0,5,0,5"/>
                                <ComboBox x:Name="DebugErrorTypeComboBox" Height="30" FontSize="12">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="429"/>
                                    <ComboBoxItem Content="Timeout"/>
                                    <ComboBoxItem Content="Random"/>
                                    <ComboBoxItem Content="AlternatingKeys"/>
                                    <ComboBoxItem Content="FirstTwoFail"/>
                                </ComboBox>
                                
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#AAAAAA" Margin="0,10,0,0">
                                    <Run Text="• 429 = Tests API key switching"/>
                                    <LineBreak/>
                                    <Run Text="• Timeout = Tests model switching"/>
                                    <LineBreak/>
                                    <Run Text="• AlternatingKeys = Best for rotation testing"/>
                                    <LineBreak/>
                                    <Run Text="⚠️ Turn OFF for normal use!"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🐛 Debug Logs" FontSize="14" FontWeight="Bold"
                                Foreground="White" Margin="0,10,0,10" Effect="{StaticResource Shadow}"/>
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                                BorderBrush="#70FF00FF" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button Content="📋 Copy" Width="70" Height="25" Click="CopyLogsButton_Click"
                                        Background="#50FFFFFF" BorderBrush="#90FFFFFF" BorderThickness="1"
                                        Foreground="White" FontSize="11" Margin="0,0,5,0"
                                        Style="{StaticResource ButtonStyle}"/>
                                    <Button Content="🗑️ Clear" Width="70" Height="25" Click="ClearLogsButton_Click"
                                        Background="#50FF0000" BorderBrush="#90FF0000" BorderThickness="1"
                                        Foreground="White" FontSize="11"
                                        Style="{StaticResource ButtonStyle}"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#30000000" BorderBrush="#50FFFFFF"
                                        BorderThickness="1" CornerRadius="4" Padding="8">
                                    <ScrollViewer x:Name="DebugScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="DebugLogsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                              Foreground="#00FF00" FontFamily="Consolas"
                                                              FontSize="11" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <CheckBox Grid.Row="2" x:Name="AutoScrollCheckBox"
                                         Content="Auto-scroll to latest"
                                         Foreground="White" FontSize="11" Margin="0,8,0,0"
                                         IsChecked="True"/>
                            </Grid>
                        </Border>

                        <!-- Companion Mode -->
                        <Border Background="#30FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Companion Mode" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Pair your phone to trigger Capture &amp; Ask remotely. Grant nothing extra on Windows beyond what Phantom already uses. Pair before the session."
                                           TextWrapping="Wrap" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                                <CheckBox x:Name="CompanionEnabledCheckBox" Content="Enable Companion Mode"
                                          Foreground="White" FontSize="13" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="CompanionShowCodeButton" Content="Show pairing code" Width="140" Height="28"
                                            Click="CompanionShowCodeButton_Click" Margin="0,0,10,0"
                                            Background="#5000AA00" BorderBrush="#9000AA00" BorderThickness="1.5"
                                            Foreground="White" FontSize="11" Style="{StaticResource ButtonStyle}"/>
                                    <Button x:Name="CompanionUnpairButton" Content="Unpair" Width="90" Height="28"
                                            Click="CompanionUnpairButton_Click"
                                            Background="#50FF0000" BorderBrush="#90FF0000" BorderThickness="1.5"
                                            Foreground="White" FontSize="11" Style="{StaticResource ButtonStyle}"/>
                                </StackPanel>
                                <TextBlock x:Name="CompanionPairingCodeText" FontFamily="Consolas" FontSize="20"
                                           Foreground="#00FF00" Margin="0,0,0,6" Visibility="Collapsed"/>
                                <Image x:Name="CompanionQrImage" Width="180" Height="180" Margin="0,0,0,6"
                                       Visibility="Collapsed" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="CompanionQrPayloadText" FontFamily="Consolas" FontSize="10"
                                           Foreground="#AAAAAA" Margin="0,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="CompanionStatusText" Text="Not paired"
                                           Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Save" Width="100" Height="35" Click="SaveButton_Click" Margin="0,0,10,0"
                           Background="#5000AA00" BorderBrush="#9000AA00" BorderThickness="1.5"
                           Foreground="White" FontWeight="Bold" FontSize="14"
                           Style="{StaticResource ButtonStyle}"/>
                    <Button Content="Cancel" Width="100" Height="35" Click="CancelButton_Click"
                           Background="#50AA0000" BorderBrush="#90AA0000" BorderThickness="1.5"
                           Foreground="White" FontWeight="Bold" FontSize="14"
                           Style="{StaticResource ButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
