<Window x:Class="SecureOverlay.ScreenshotCapture"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Capture" 
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="#80000000"
        WindowState="Maximized"
        Cursor="None"
        KeyDown="Window_KeyDown">
    
    <Grid>
        <!-- Instruction overlay -->
        <Border Background="#DD000000" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Center" 
                Margin="0,20,0,0" 
                Padding="20,10"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="📸 Screenshot Capture" 
                          FontSize="18" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Click and drag to select a region, or press:" 
                          FontSize="12" 
                          Foreground="#CCFFFFFF" 
                          HorizontalAlignment="Center" 
                          Margin="0,8,0,0"/>
                <TextBlock Text="ENTER = Capture full screen  |  ESC = Cancel" 
                          FontSize="12" 
                          Foreground="#AAFFFFFF" 
                          HorizontalAlignment="Center" 
                          Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Selection rectangle -->
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle" 
                      Stroke="#00A8FF" 
                      StrokeThickness="2" 
                      Fill="#3300A8FF" 
                      Visibility="Collapsed"/>
        </Canvas>

        <!-- ✅ NEW: Custom cursor canvas (top layer) -->
        <Canvas x:Name="CustomCursorCanvas" 
                IsHitTestVisible="False" 
                Background="Transparent">
        </Canvas>
    </Grid>
</Window>
