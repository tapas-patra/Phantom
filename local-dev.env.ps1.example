$env:PHANTOM_WINDOWS_BACKEND_BASE_URL = 'http://localhost:5057'
$env:PHANTOM_WEBSITE_BASE_URL = 'http://localhost:4173'
$env:VITE_PHANTOM_DASHBOARD_API_BASE_URL = 'http://localhost:5067'
