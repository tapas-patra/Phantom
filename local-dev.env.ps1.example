$env:PHANTOM_WINDOWS_BACKEND_DATABASE_URL = 'Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require'
$env:PHANTOM_WINDOWS_BACKEND_INTERNAL_API_KEY = 'change-this-internal-service-key'

$env:PHANTOM_DASHBOARD_BACKEND_DATABASE_URL = $env:PHANTOM_WINDOWS_BACKEND_DATABASE_URL
$env:PHANTOM_BOOTSTRAP_ADMIN_EMAIL = 'admin@example.com'
$env:PHANTOM_BOOTSTRAP_ADMIN_PASSWORD = 'change-this-admin-password'
$env:PHANTOM_BOOTSTRAP_ADMIN_DISPLAY_NAME = 'Phantom Admin'
$env:PHANTOM_WINDOWS_BACKEND_BASE_URL = 'http://localhost:5057'
$env:PHANTOM_PUBLIC_WEBSITE_BASE_URL = 'http://localhost:4173'
# Leave unset for localhost. Only set this for a real shared parent domain in production.
# $env:PHANTOM_SHARED_COOKIE_DOMAIN = '.yourdomain.com'
$env:PHANTOM_WINDOWS_BACKEND_SECRET_ENCRYPTION_KEY = 'REPLACE_WITH_BASE64_32_BYTE_KEY'
$env:PHANTOM_WINDOWS_BACKEND_DOWNLOAD_SIGNING_KEY = 'REPLACE_WITH_AN_INDEPENDENT_HIGH_ENTROPY_SIGNING_KEY'
$env:PHANTOM_WINDOWS_BACKEND_DOWNLOAD_LINK_TTL_MINUTES = '3'
$env:PHANTOM_WINDOWS_BACKEND_RELEASE_REPOSITORY = 'tapas-patra/phantom-release-repo'
$env:PHANTOM_WINDOWS_BACKEND_RELEASE_TAG = 'desktop-latest'
$env:PHANTOM_WINDOWS_BACKEND_ADMIN_OTP_TTL_MINUTES = '10'
$env:PHANTOM_WINDOWS_BACKEND_ADMIN_OTP_MAX_ATTEMPTS = '5'
# Keep false locally. Set both to true only on deployments where all traffic
# reaches the services through the trusted Render reverse proxy.
$env:PHANTOM_WINDOWS_BACKEND_TRUST_FORWARDED_HEADERS = 'false'
$env:PHANTOM_DASHBOARD_BACKEND_TRUST_FORWARDED_HEADERS = 'false'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_ENABLED = 'true'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_PROVIDER = 'openai'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_BASE_URL = 'https://api.openai.com/v1'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_API_KEY = 'replace-me'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_MODEL = 'text-embedding-3-small'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_DIMENSIONS = '1536'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_VERSION = '1'
$env:PHANTOM_WINDOWS_BACKEND_KB_EMBEDDING_BATCH_SIZE = '32'
$env:PHANTOM_WINDOWS_BACKEND_KB_QUERY_EMBEDDING_TIMEOUT_MS = '5000'
$env:PHANTOM_WINDOWS_BACKEND_KB_QUERY_EMBEDDING_RETRIES = '0'
$env:PHANTOM_WINDOWS_BACKEND_KB_QUERY_EMBEDDING_RETRY_DELAY_MS = '75'
$env:PHANTOM_WINDOWS_BACKEND_KB_QUERY_EMBEDDING_CACHE_ENTRIES = '512'
$env:PHANTOM_WINDOWS_BACKEND_KB_QUERY_EMBEDDING_CACHE_TTL_MINUTES = '30'
$env:PHANTOM_WINDOWS_BACKEND_GOOGLE_OAUTH_CLIENT_SECRETS_PATH = 'D:\Phantom\secrets\gmail-web-client.json'
$env:PHANTOM_WINDOWS_BACKEND_GOOGLE_OAUTH_REFRESH_TOKEN = ''
$env:PHANTOM_WINDOWS_BACKEND_GOOGLE_OAUTH_REDIRECT_URI = 'http://localhost:5057/api/admin/integrations/gmail/oauth/callback'
$env:PHANTOM_WINDOWS_BACKEND_SMTP_FROM_EMAIL = 'official.phantomai@gmail.com'
$env:PHANTOM_WINDOWS_BACKEND_RAZORPAY_KEY_ID = 'rzp_test_replace_me'
$env:PHANTOM_WINDOWS_BACKEND_RAZORPAY_KEY_SECRET = 'replace-me'
$env:PHANTOM_WINDOWS_BACKEND_RAZORPAY_WEBHOOK_SECRET = 'replace-me'
$env:PHANTOM_WINDOWS_BACKEND_OTP_PROVIDER = '2factor'
$env:PHANTOM_WINDOWS_BACKEND_OTP_API_KEY = 'replace-me'
$env:PHANTOM_WINDOWS_BACKEND_OTP_TEMPLATE_NAME = 'replace-me'
# Local-only testing option:
# $env:ASPNETCORE_ENVIRONMENT = 'Development'
# $env:PHANTOM_WINDOWS_BACKEND_OTP_PROVIDER = 'mock'
# $env:PHANTOM_WINDOWS_BACKEND_MOCK_OTP_CODE = '111111'

$env:PHANTOM_WEBSITE_BASE_URL = 'http://localhost:4173'
$env:VITE_PHANTOM_DASHBOARD_API_BASE_URL = 'http://localhost:5067'
$env:VITE_PHANTOM_WINDOWS_BACKEND_API_BASE_URL = 'http://localhost:5057'
# Optional desktop RAG trace log:
# $env:RAG_LOG = 'true'
